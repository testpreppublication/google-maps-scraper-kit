# syntax=docker/dockerfile:1
ARG GO_VERSION=1.27.1
ARG PLAYWRIGHT_GO_VERSION=v0.6100.0

# Build a current scraper binary that uses the maintained Playwright Go fork.
FROM golang:${GO_VERSION}-trixie AS scraper-builder
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 https://github.com/gosom/google-maps-scraper.git .
RUN go mod download
RUN CGO_ENABLED=0 go build -ldflags="-w -s" -o /usr/bin/google-maps-scraper

# Install the exact Playwright driver/browser expected by current scraper dependencies.
FROM golang:${GO_VERSION}-trixie AS playwright-deps
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/browsers
ENV PLAYWRIGHT_DRIVER_PATH=/opt/ms-playwright-go
ARG PLAYWRIGHT_GO_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && go install github.com/mxschmitt/playwright-go/cmd/playwright@${PLAYWRIGHT_GO_VERSION} \
    && mkdir -p /opt/browsers \
    && playwright install chromium --with-deps

FROM debian:trixie-slim

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/browsers \
    PLAYWRIGHT_DRIVER_PATH=/opt/ms-playwright-go \
    SCRAPER_BASE_URL=http://127.0.0.1:8080 \
    JOBS_DIR=/data/jobs \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates python3 python3-venv \
       libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 \
       libxkbcommon0 libatspi2.0-0 libx11-6 libxcomposite1 libxdamage1 libxext6 \
       libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir "mcp>=2,<3" "uvicorn>=0.30,<1" \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:$PATH"

COPY --from=scraper-builder /usr/bin/google-maps-scraper /usr/bin/google-maps-scraper
COPY --from=playwright-deps /opt/browsers /opt/browsers
COPY --from=playwright-deps /opt/ms-playwright-go /opt/ms-playwright-go

RUN chmod -R 755 /opt/browsers /opt/ms-playwright-go \
    && mkdir -p /data/jobs /gmapsdata

WORKDIR /app
COPY scripts/ ./scripts/
COPY cloud/ ./cloud/

ENTRYPOINT []
CMD ["sh", "-c", "uvicorn cloud.mcp_app:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*'"]
